# Production runtime (required; inject through the deployment secret manager).
# Keep production values out of source control, images, build logs, and shell history.
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Final absolute HTTPS origin only; no credentials, path, query, or fragment.
ADMIN_SITE_ORIGIN=

# Local/CI browser verification only. Never inject this plaintext password into
# the production application runtime. It must match ADMIN_PASSWORD_HASH in tests.
PLAYWRIGHT_ADMIN_PASSWORD=
