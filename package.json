{
  "name": "personal-tech-lab-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run lint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:validate": "node --env-file-if-exists=.env.local ./node_modules/.bin/prisma validate",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/.bin/prisma generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/.bin/prisma migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local ./node_modules/.bin/prisma migrate deploy",
    "admin:hash-password": "tsx scripts/generate-admin-password-hash.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "security:scan": "node scripts/security-source-scan.mjs",
    "security:scan:self-test": "node scripts/security-source-scan.mjs --self-test",
    "security:smoke": "node scripts/security-production-smoke.mjs",
    "verify": "npm run lint && npm run test:unit && npm run db:validate && npm run db:generate && npm run build && npm run security:scan",
    "verify:ci": "npm run verify && npm audit --audit-level=high && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tiptap/core": "3.27.3",
    "@tiptap/extension-code-block": "3.27.3",
    "@tiptap/extension-image": "3.27.3",
    "@tiptap/extension-link": "3.27.3",
    "@tiptap/extension-list": "3.27.3",
    "@tiptap/extension-placeholder": "3.27.3",
    "@tiptap/extension-table": "3.27.3",
    "@tiptap/markdown": "3.27.3",
    "@tiptap/pm": "3.27.3",
    "@tiptap/react": "3.27.3",
    "@tiptap/starter-kit": "3.27.3",
    "@uiw/react-md-editor": "4.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.22.0",
    "motion": "12.42.0",
    "next": "16.2.9",
    "parse-entities": "4.0.2",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "reading-time": "1.5.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.34.5",
    "shiki": "4.3.0",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.0.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.6.0",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.16",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    },
    "postcss": "$postcss"
  }
}
